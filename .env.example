# Server
PORT=3014

# Supabase — syllabus_chapters, syllabus_topics, topic_resources
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq — IB PYP/CBSE practice quiz generation + wrong-answer explanations
GROQ_API_KEY=

# Qdrant — read-only curriculum browsing for GET /curriculum/subjects and
# /curriculum/syllabus (same instance aivorah-ai-coach-service uses for RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Firebase Admin — verifies teacher ID tokens for /teacher-curriculum/* routes.
# One of FIREBASE_SERVICE_ACCOUNT_B64 (Cloud Run), FIREBASE_SERVICE_ACCOUNT, or
# a local firebase-service-account.json file.
FIREBASE_SERVICE_ACCOUNT_B64=

# Cloudinary — persistent storage for uploaded teacher curriculum files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Job queue for curriculum extraction/generation — 'db' (default, Supabase
# upload_jobs table, shared with aivorah-assignments-service) or 'kafka'
QUEUE_DRIVER=db

# Max curriculum upload size in MB (default 25, matches the legacy monolith's
# syllabusImport.js limit)
CURRICULUM_MAX_FILE_MB=25
