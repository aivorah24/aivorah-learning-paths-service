# Server
PORT=3014

# Supabase — syllabus_chapters, syllabus_topics, topic_resources
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM provider fallback chain — every generation call site (enrichment,
# curriculum upload, grade-fit judge, IB PYP quiz) goes through
# services/llm/fallback.js's callWithFallback, which tries these in order,
# skipping any entry whose key env below isn't set. A short rate-limit
# retries once; a daily-limit/5xx/network error cools that entry down for
# ~15min and moves to the next; a 401/403 disables it for the process.
# Format: "provider:model,provider:model,...".
LLM_CHAIN=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# Optional per-task chains (each falls back to LLM_CHAIN, then built-in defaults
# that spread tasks across models: content=gpt-oss-120b, companions=qwen, judge=gpt-oss-20b).
# LLM_CHAIN_CONTENT=
# LLM_CHAIN_COMPANIONS=
# LLM_CHAIN_JUDGE=

# Job worker isolation: local dev and the live service share upload_jobs.
# Set a unique pool locally (e.g. local-<name>) so only this worker claims its jobs.
# JOB_WORKER_POOL=default
# JOB_STALE_MINUTES=30

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Back-compat generic OpenAI-compatible endpoint — only used if LLM_CHAIN
# includes a "custom:<model>" entry.
KNOWLEDGE_LLM_BASE_URL=
KNOWLEDGE_LLM_API_KEY=

# Qdrant — read-only curriculum browsing for GET /curriculum/subjects and
# /curriculum/syllabus (same instance aivorah-ai-coach-service uses for RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Firebase Admin — verifies teacher ID tokens for /teacher-curriculum/* routes.
# One of FIREBASE_SERVICE_ACCOUNT_B64 (Cloud Run), FIREBASE_SERVICE_ACCOUNT, or
# a local firebase-service-account.json file.
FIREBASE_SERVICE_ACCOUNT_B64=

# Cloudinary — persistent storage for uploaded teacher curriculum files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Job queue for curriculum extraction/generation — 'db' (default, Supabase
# upload_jobs table, shared with aivorah-assignments-service) or 'kafka'
QUEUE_DRIVER=db

# Max curriculum upload size in MB (default 25, matches the legacy monolith's
# syllabusImport.js limit)
CURRICULUM_MAX_FILE_MB=25
